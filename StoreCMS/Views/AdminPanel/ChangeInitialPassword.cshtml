@{
    Layout = null;
}
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Смена первоначального пароля</title>
    <link rel="stylesheet" href="/styles/admin_panel/common.css" />
</head>
<body>
    <main style="max-width: 560px; margin: 40px auto; padding: 20px;">
        <h1>Смените первоначальный пароль</h1>
        <p>Для доступа к административной панели установите собственный пароль вместо admin.</p>
        @if (ViewData["PasswordChangeError"] != null)
        {
            <p role="alert">@ViewData["PasswordChangeError"]</p>
        }
        <form method="post" action="@(Context.Request.PathBase.Add(Context.Request.Path))">
            <input type="hidden" name="pageID" value="@((int)AdminPanelPages.ChangeInitialPassword)" />
            <p><label>Текущий пароль<br /><input type="password" name="UserModel.CurrentPassword" autocomplete="current-password" required /></label></p>
            <p><label>Новый пароль<br /><input type="password" name="UserModel.NewPassword" autocomplete="new-password" minlength="5" required /></label></p>
            <p><label>Повтор нового пароля<br /><input type="password" name="UserModel.ConfirmPassword" autocomplete="new-password" minlength="5" required /></label></p>
            <p>Не менее 5 символов: латинские буквы, цифры и -_!@@#$%&amp;?*№~= . Пароль admin запрещён.</p>
            <button type="submit">Изменить пароль</button>
        </form>
        <form id="initial-password-exit">
            <input type="hidden" name="pageID" value="@((int)AdminPanelPages.Exit)" />
            <button type="submit">Выйти</button>
        </form>
        <script>
            document.getElementById('initial-password-exit').addEventListener('submit', function (event) {
                event.preventDefault();
                var request = new XMLHttpRequest();
                request.open('DELETE', this.previousElementSibling.action);
                request.onload = function () { if (request.status === 200) location.reload(); };
                request.send(new FormData(this));
            });
        </script>
    </main>
</body>
</html>
